# Copy to /etc/video2book.env; owner root:root, permissions 0600.
# Set a unique password before starting.
BOOKSITE_PASSWORD=CHANGE_ME
# The application binds to loopback and persists its private session key
# in --data-dir; include that directory in backups.
# Keep manual import / subtitle-only behavior until a real paid/free-credit
# sample and the current provider price have been checked.
BOOKSITE_AUTO_WRITE=0
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-122B-A10B
BOOKSITE_MAX_OUTPUT_TOKENS=8192
# Add SILICONFLOW_API_KEY only to the private /etc/video2book.env (0600).
# Never put a real key in this template or Git.
