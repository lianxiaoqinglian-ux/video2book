[Unit]
Description=Video2book personal web interface
After=network.target

[Service]
Type=simple
User=video2book
Group=video2book
WorkingDirectory=/opt/video2book
EnvironmentFile=/etc/video2book.env
Environment=PYTHONUNBUFFERED=1
Environment=BOOKSITE_DATA_DIR=/var/lib/video2book
ExecStart=/opt/video2book/.venv/bin/gunicorn --bind 127.0.0.1:8000 --workers 1 --threads 2 --timeout 60 website.server:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/video2book

[Install]
WantedBy=multi-user.target
